    "COL_GOLD = '#c9a84c'   # gold   — ratio / accent\n",
    "COL_GREY = '#888888'\n",
    "\n",
    "ETA = 1.8392867552141612   # dominant root of x³ − x² − x − 1 = 0\n",
    "PHI = 1.6180339887498949   # golden ratio"
   ]
