   "source": [
    "## Cell 2 — Substitution chain generation\n",
    "\n",
    "**Fibonacci:** A → AB, B → A (encoded 0, 1)  \n",
    "**Tribonacci (Rauzy):** 1 → 12, 2 → 13, 3 → 1 (encoded 0, 1, 2)\n",
    "\n",
    "Companion matrix $T_3 = \\bigl(\\begin{smallmatrix}1&1&1\\\\1&0&0\\\\0&1&0\\end{smallmatrix}\\bigr)$, $\\det(T_3)=1$, $\\rho(T_3)=\\eta$.  \n",
    "Letter frequencies → PF eigenvector: $(f_1,f_2,f_3)\\approx(0.5437,0.2956,0.1607)$."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-02",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 2 — Substitution chain generation\n",
    "\n",
    "def fibonacci_word(length):\n",
    "    \"\"\"A→AB, B→A. Returns first `length` symbols as list of ints.\"\"\"\n",
    "    word = [0]\n",
    "    rules = {0: [0, 1], 1: [0]}\n",
    "    while len(word) < length:\n",
    "        word = [s for c in word for s in rules[c]]\n",
    "    return word[:length]\n",
    "\n",
    "def tribonacci_word(length):\n",
    "    \"\"\"Rauzy: 1→12, 2→13, 3→1. Returns first `length` symbols.\"\"\"\n",
    "    word = [0]\n",
    "    rules = {0: [0, 1], 1: [0, 2], 2: [0]}\n",
    "    while len(word) < length:\n",
    "        word = [s for c in word for s in rules[c]]\n",
    "    return word[:length]\n",
    "\n",
    "# Verify tribonacci letter frequencies converge to PF eigenvector\n",
    "N_check = 10000\n",
    "wt = tribonacci_word(N_check)\n",
    "f1 = wt.count(0)/N_check\n",
    "f2 = wt.count(1)/N_check\n",
    "f3 = wt.count(2)/N_check\n",
    "print(f'Tribonacci letter freqs (N={N_check}): f1={f1:.4f}  f2={f2:.4f}  f3={f3:.4f}')\n",
    "print(f'Expected (PF eigenvector):              f1≈0.5437  f2≈0.2956  f3≈0.1607')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "md-02",
   "metadata": {},
   "source": [
    "## Cell 3 — Hamiltonian & mid-gap eigenstate\n",
    "\n",
    "$H_{j,j\\pm1} = t_{\\text{word}[j]}$, diagonal = 0.  \n",
    "Hopping: letter 0 → $t_A=1.0$, letter 1 → $t_B=t_{\\rm mod}$, letter 2 → $t_C=t_{\\rm mod}^2$.  \n",
    "$t_{\\rm mod}=0.5$ throughout (generic incommensurate point, paper default)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-03",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 3 — Tight-binding Hamiltonian & mid-gap eigenstate\n",
    "\n",
    "T_MOD = 0.5\n",
    "N     = 500   # chain length (paper default for figs 2–4)\n",
    "\n",
    "def build_hamiltonian(word, N, t_mod=T_MOD):\n",
    "    \"\"\"\n",
    "    Build N×N tridiagonal tight-binding Hamiltonian.\n",
    "    Returns (H, hoppings) where hoppings is the (N-1,) bond array.\n",
    "    \"\"\"\n",
    "    hop_map  = {0: 1.0, 1: t_mod, 2: t_mod**2}\n",
    "    hoppings = np.array([hop_map.get(word[j], t_mod) for j in range(N - 1)])\n",
    "    H = np.zeros((N, N))\n",
    "    for j in range(N - 1):\n",
    "        H[j, j+1] = hoppings[j]\n",
    "        H[j+1, j] = hoppings[j]\n",
    "    return H, hoppings\n",
    "\n",
    "def mid_gap_state(H):\n",
    "    \"\"\"Eigenstate of H with eigenvalue closest to E=0 (mid-gap critical state).\"\"\"\n",
    "    vals, vecs = eigh(H)\n",
    "    idx = np.argmin(np.abs(vals))\n",
    "    return vecs[:, idx], vals[idx]\n",
    "\n",
    "word_fib  = fibonacci_word(N + 1)\n",
    "word_trib = tribonacci_word(N + 1)\n",
    "H_fib,  hop_fib  = build_hamiltonian(word_fib,  N)\n",
    "H_trib, hop_trib = build_hamiltonian(word_trib, N)\n",
    "psi0_fib,  E_fib  = mid_gap_state(H_fib)\n",
    "psi0_trib, E_trib = mid_gap_state(H_trib)\n",
    "\n",
    "print(f'Fibonacci  mid-gap E = {E_fib:.6f}')\n",
    "print(f'Tribonacci mid-gap E = {E_trib:.6f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "md-03",
   "metadata": {},
   "source": [
    "## Cell 4 — IPR measurement\n",
    "\n",
    "$$\\text{IPR} = \\frac{\\sum_j |\\psi_j|^4}{\\left(\\sum_j |\\psi_j|^2\\right)^2}$$\n",
    "\n",
    "IPR → 1: fully localised. IPR → 1/N: fully delocalised. IPR ~ N^{−D₂}: multifractal critical."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-04",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 4 — IPR\n",
    "\n",
    "def ipr(psi):\n",
    "    \"\"\"Inverse Participation Ratio. Works on unnormalised ψ.\"\"\"\n",
    "    norm2 = np.sum(np.abs(psi)**2)\n",
    "    return np.sum(np.abs(psi)**4) / norm2**2\n",
    "\n",
    "ipr0_fib  = ipr(psi0_fib)\n",
    "ipr0_trib = ipr(psi0_trib)\n",
    "print(f'Linear-limit IPR (λ=0):')\n",
    "print(f'  Fibonacci  : {ipr0_fib:.6f}')\n",
    "print(f'  Tribonacci : {ipr0_trib:.6f}')\n",
    "print(f'  Ratio trib/fib : {ipr0_trib/ipr0_fib:.4f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "md-04",
   "metadata": {},
   "source": [
    "## Cell 5 — DNLS time evolution\n",
    "\n",
    "$$i\\,\\frac{d\\psi_j}{dt} = -\\sum_{j'} H_{jj'}\\psi_{j'} + \\lambda|\\psi_j|^2\\psi_j$$\n",
    "\n",
    "Real split: state $= [\\mathrm{Re}(\\psi);\\,\\mathrm{Im}(\\psi)]$\n",
    "$$\\dot{x} = -Hy + \\lambda|\\psi|^2 y, \\qquad \\dot{y} = Hx - \\lambda|\\psi|^2 x$$\n",
    "\n",
    "Default integrator: **RK45** for $T\\le100$. Use **DOP853** for $T\\ge10^4$ (8th-order, ~10× fewer steps)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-05",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 5 — DNLS evolution\n",
    "\n",
    "def evolve_dnls(psi0, hoppings, lam, T_evo,\n",
    "                integrator='RK45', rtol=1e-8, atol=1e-10):\n",
    "    \"\"\"\n",
    "    Evolve DNLS from t=0 to t=T_evo.\n",
    "    Returns (psi_final, t_checkpoints).\n",
    "    Set integrator='DOP853' for long runs (T >= 1e4).\n",
    "    \"\"\"\n",
    "    N  = len(psi0)\n",
    "    h  = hoppings\n",
    "    s0 = np.concatenate([psi0.real, psi0.imag])\n",
    "\n",
    "    def rhs(t, state):\n",
    "        x, y = state[:N], state[N:]\n",
    "        Hx = np.zeros(N); Hy = np.zeros(N)\n",
    "        Hx[:-1] += h * x[1:];  Hx[1:] += h * x[:-1]\n",
    "        Hy[:-1] += h * y[1:];  Hy[1:] += h * y[:-1]\n",
    "        mod2 = x**2 + y**2\n",
    "        return np.concatenate([\n",
    "            -Hy + lam * mod2 * y,\n",
    "             Hx - lam * mod2 * x\n",
    "        ])\n",
    "\n",
    "    t_eval = np.unique(np.concatenate(\n",
    "        [[0.0], np.logspace(0, np.log10(T_evo), 200)]))\n",
    "    sol = solve_ivp(rhs, [0, T_evo], s0, method=integrator,\n",
    "                    t_eval=t_eval, rtol=rtol, atol=atol)\n",
    "    psi_f = sol.y[:N, -1] + 1j * sol.y[N:, -1]\n",
    "\n",
    "    # Norm conservation check\n",
    "    drift = abs(np.sum(np.abs(psi_f)**2) - np.sum(np.abs(psi0)**2))\n",
    "    if drift / np.sum(np.abs(psi0)**2) > 1e-4:\n",
    "        print(f'  WARNING: norm drift {drift:.2e}  λ={lam}  T={T_evo}')\n",
    "\n",
    "    return psi_f, sol.t\n",
    "\n",
    "# Smoke test\n",
    "pf_t, _ = evolve_dnls(psi0_fib,  hop_fib,  1.5, 50.0)\n",
    "pt_t, _ = evolve_dnls(psi0_trib, hop_trib, 1.5, 50.0)\n",
    "df = 100*(ipr0_fib  - ipr(pf_t))/ipr0_fib\n",
    "dt = 100*(ipr0_trib - ipr(pt_t))/ipr0_trib\n",
    "print(f'λ=1.5, T=50:')\n",
    "print(f'  Fibonacci  IPR drop : {df:.1f}%   (expect ≈57%)')\n",
    "print(f'  Tribonacci IPR drop : {dt:.1f}%   (expect <5%)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-06",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 6 — Full λ scan → Table 1\n",
    "\n",
    "T_EVO  = 50.0\n",
    "LAMBDA = [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 5.0, 7.0, 10.0]\n",
    "\n",
    "ipr_fib_list  = [ipr0_fib]\n",
    "ipr_trib_list = [ipr0_trib]\n",
    "\n",
    "for lam in LAMBDA[1:]:\n",
    "    pf, _ = evolve_dnls(psi0_fib,  hop_fib,  lam, T_EVO)\n",
    "    pt, _ = evolve_dnls(psi0_trib, hop_trib, lam, T_EVO)\n",
    "    ipr_fib_list.append(ipr(pf))\n",
    "    ipr_trib_list.append(ipr(pt))\n",
    "\n",
    "ipr_fib_arr  = np.array(ipr_fib_list)\n",
    "ipr_trib_arr = np.array(ipr_trib_list)\n",
    "ratio_arr    = ipr_trib_arr / ipr_fib_arr\n",
    "lam_arr      = np.array(LAMBDA)\n",
    "\n",
    "print(f\"{'λ':>6}  {'IPR_trib':>10}  {'IPR_fib':>10}  {'ratio':>7}  {'Δtrib%':>8}  {'Δfib%':>8}\")\n",
    "print('─'*62)\n",
    "for i, lam in enumerate(LAMBDA):\n",
    "    dt = 100*(ipr0_trib - ipr_trib_arr[i])/ipr0_trib\n",
    "    df = 100*(ipr0_fib  - ipr_fib_arr[i]) /ipr0_fib\n",
    "    print(f'{lam:>6.1f}  {ipr_trib_arr[i]:>10.4f}  {ipr_fib_arr[i]:>10.4f}  '\n",
    "          f'{ratio_arr[i]:>7.3f}  {dt:>7.1f}%  {df:>7.1f}%')"
   ]
  },
