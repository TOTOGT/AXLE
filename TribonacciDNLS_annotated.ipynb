    "\n",
    "def draw_substitution_tree(ax, rules, letter_names, colors,\n",
    "                           n_gen=4, x0=0.5, y0=0.92, dx_scale=0.42):\n",
    "    def draw_node(letter, x, y, depth, parent_xy=None):\n",
    "        if parent_xy is not None:\n",
    "            ax.annotate('', xy=(x, y+0.025), xytext=parent_xy,\n",
    "                        arrowprops=dict(arrowstyle='->', lw=0.7, color='#666'))\n",
    "        ax.scatter([x], [y], s=180, color=colors[letter], zorder=3,\n",
    "                   edgecolors='white', linewidth=0.8)\n",
    "        ax.text(x, y, letter_names[letter], ha='center', va='center',\n",
    "                fontsize=7, color='white', fontweight='bold', zorder=4)\n",
    "        if depth >= n_gen:\n",
    "            return\n",
    "        children = rules[letter]\n",
    "        xs = np.linspace(x - dx_scale/2**depth,\n",
    "                         x + dx_scale/2**depth, len(children))\n",
    "        for i, child in enumerate(children):\n",
    "            draw_node(child, xs[i], y - 0.16, depth+1, (x, y-0.025))\n",
    "\n",
