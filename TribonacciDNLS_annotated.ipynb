    "    'savefig.bbox': 'tight', 'savefig.pad_inches': 0.05,\n",
    "    'axes.spines.top': False, 'axes.spines.right': False,\n",
    "    'axes.linewidth': 0.8, 'lines.linewidth': 1.8,\n",
